{
	"name": "@orbitdb/core",
	"version": "2.5.0",
	"description": "Distributed p2p database on IPFS",
	"author": "Haad",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/orbitdb/orbitdb"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"files": ["src", "dist"],
	"type": "module",
	"main": "dist/esm/index.js",
	"module": "dist/esm/index.js",
	"types": "./dist/esm/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/index.js"
		}
	},
	"dependencies": {
		"@ast-grep/napi-darwin-arm64": "^0.38.2",
		"@ipld/dag-cbor": "^9.0.6",
		"@libp2p/crypto": "^5.0.5",
		"it-drain": "^3.0.9",
		"it-pipe": "^3.0.1",
		"level": "^8.0.0",
		"lru": "^3.1.0",
		"multiformats": "^12.1.3",
		"p-queue": "^8.0.1",
		"timeout-abort-controller": "^3.0.0",
		"uint8arrays": "^5.0.0"
	},
	"devDependencies": {
		"@chainsafe/libp2p-gossipsub": "^14.1.0",
		"@libp2p/circuit-relay-v2": "^3.1.0",
		"@rsbuild/plugin-node-polyfill": "^1.3.0",
		"@rslib/core": "^0.7.1",
		"@rstest/core": "^0.0.6",
		"@types/node": "^24.0.10",
		"blockstore-level": "^2.0.1",
		"c8": "^8.0.1",
		"cross-env": "^7.0.3",
		"fs-extra": "^11.2.0",
		"helia": "^5.2.1",
		"it-all": "^3.0.4",
		"jsdoc": "^4.0.2",
		"mocha": "^10.2.0",
		"path-browserify": "^1.0.1",
		"playwright-test": "^14.1.6",
		"rimraf": "^5.0.5",
		"standard": "^17.1.0",
		"typescript": "^5.8.3"
	},
	"scripts": {
		"test": "rstest",
		"test:ci": "rstest --coverage",
		"build": "rslib build",
		"build:docs": "jsdoc -c ./conf/jsdoc/jsdoc.json -r src/** -d ./docs/api -R ./docs/jsdoc/README.md",
		"prepublishOnly": "bun run build",
		"lint": "standard --env=mocha",
		"lint:fix": "standard --fix",
		"typecheck": "tsc --noEmit",
		"webrtc": "node ./test/utils/relay.js",
		"webrtc:background": "node ./test/utils/relay.js &"
	},
	"standard": {
		"env": ["mocha"],
		"ignore": ["out/**", "test/fixtures/**", "test/browser/**", "docs/**", "dist/**", "node_modules/**", "conf/**"]
	},
	"keywords": [
		"crdt",
		"merkle-crdt",
		"database",
		"decentralized",
		"decentralised",
		"distributed",
		"ipfs",
		"libp2p",
		"p2p",
		"peer-to-peer"
	]
}
